# Server-only secrets. Do not prefix any of these variables with NEXT_PUBLIC_.
PORT=:8080
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://storelift:storelift_local_only@127.0.0.1:5433/storelift?sslmode=disable
PAGESPEED_API_KEY=
# Generate interactively with: go run ./cmd/hashpassword
ADMIN_PASSWORD_HASH=
# Enable real checkout only after obtaining test-mode credentials and HTTPS preview URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://storelift.example.invalid
# Random 32+ character secret for shared PostgreSQL per-IP-hash rate limiting.
RATE_LIMIT_SECRET=

# Exact ingress proxy source IP CIDRs only; by default ignore X-Forwarded-For.
# Example for a local trusted nginx: 127.0.0.1/32,::1/128
# Never use broad internet ranges (0.0.0.0/0 or ::/0).
TRUSTED_PROXY_CIDRS=

# MUST remain false/unset until the business owner explicitly approves a
# production launch, legal policies, tax handling and live Stripe activation.
# sk_test_ keys are allowed for non-production test checkout.
STORELIFT_LIVE_PAYMENTS_APPROVED=false
