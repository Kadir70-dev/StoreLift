# STAGING ONLY — copy to deploy/.env.staging and chmod 600; NEVER commit real values.
# Go container listens inside the container on 8080.
PORT=:8080

# Replace with the exact Vercel preview HTTPS origin.
WEB_ORIGIN=https://YOUR-VERCEL-PREVIEW.vercel.app
SITE_URL=https://YOUR-VERCEL-PREVIEW.vercel.app

# Managed PostgreSQL 16 (TLS required), migrated with db/schema.sql.
DATABASE_URL=

# Restricted PageSpeed Insights API key; optional until an authorized store test.
PAGESPEED_API_KEY=

# Generate interactively with: (cd api && go run ./cmd/hashpassword)
ADMIN_PASSWORD_HASH=

# Never use live keys in staging. Test keys only, supplied by the operator.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 32+ random characters to activate DB-backed rate limiting.
RATE_LIMIT_SECRET=

# Only exact IPs of the controlled HTTPS reverse proxy connected to this service.
# Empty: forwarded headers ignored. Never 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=

# Production must remain disabled until explicit owner approval.
STORELIFT_LIVE_PAYMENTS_APPROVED=false
